<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.leadinsight</groupId>
    <artifactId>lead-insight-backend</artifactId>
    <version>1.0.0</version>
    <name>lead-insight-backend</name>
    <description>企业销售线索智能识别与跟进优先级排序系统 - 后端</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.15</mybatis-plus.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- MyBatis-Plus：必须使用 spring-boot3 专用 starter，且显式声明版本 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!--
          必需依赖：MyBatis-Plus 自 3.5.9 起把依赖 JSqlParser 的 SQL 解析型插件（含 PaginationInnerInterceptor）
          拆到独立模块。ARCHITECTURE-v1.1 §2.2「可不引入」的结论对分页插件不成立：
          不引入则 PaginationInnerInterceptor 类不存在（ClassNotFoundException），分页插件无法装配。
          故本项目必须显式引入；版本与 starter 对齐。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- jjwt 0.12.6 三件套 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
          密钥防泄露（第一道：结构性阻断）
          显式声明 resources 并排除本地密钥文件，保证任何情况下都不会被打进 jar 包。
          注意：一旦显式写 <resources>，就会覆盖 Spring Boot 的默认资源目录，故必须显式写出 directory。
          另外：真实密钥的正确位置是工程根目录（与 pom.xml 同级）的 application-local.yml，
          由 application.yml 的 spring.config.import: optional:file:application-local.yml 读取，
          该路径按【进程工作目录】解析，不依赖 classpath，因此这里排除它不影响运行。
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>application-local.yml</exclude>
                    <exclude>application-local.yaml</exclude>
                    <exclude>application-local*.yml</exclude>
                    <exclude>application-local*.yaml</exclude>
                    <exclude>.env</exclude>
                    <exclude>.env.*</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!--
              密钥防泄露（第二道：构建即报错）
              若把密钥文件放错到 src/main/resources，构建会立即失败并提示正确位置，
              避免"以为放对了"却被打进 jar 交作业/外发的静默泄露。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>forbid-secret-files-in-resources</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireFilesDontExist implementation="org.apache.maven.enforcer.rules.files.RequireFilesDontExist">
                                    <message>
【密钥安全】检测到 src/main/resources 下存在本地密钥文件！
真实密钥文件的正确位置是【后端工程根目录】（与 pom.xml 同级）：
    lead-insight-backend/application-local.yml
放错位置会导致密钥被打进 jar 包，交作业或外发 jar 时一并泄露。
请把文件移动到工程根目录，或删除它（应用无 key 也能正常启动，仅降级为待人工处理）。
                                    </message>
                                    <files>
                                        <file>${project.basedir}/src/main/resources/application-local.yml</file>
                                        <file>${project.basedir}/src/main/resources/application-local.yaml</file>
                                        <file>${project.basedir}/src/main/resources/.env</file>
                                    </files>
                                </requireFilesDontExist>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                      必须在插件 configuration 中显式写 release：
                      本机全局 settings.xml 存在 <activeProfile>jdk-25</activeProfile>，
                      其 profile properties 会以「用户属性」身份覆盖 POM 里的 maven.compiler.release，
                      导致 javac 收到 release 25 而在 JDK 21 上编译失败（不支持发行版本 25）。
                      插件 configuration 的优先级高于属性，故此处锁定 21，保证标准命令即可构建。
                    -->
                    <release>21</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
